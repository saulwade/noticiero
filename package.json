{
  "name": "noticiero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "update": "node --import tsx scripts/update.ts",
    "schedule:generate": "node --import tsx scripts/local-schedule.ts",
    "schedule:install": "node --import tsx scripts/local-schedule.ts install",
    "schedule:uninstall": "node --import tsx scripts/local-schedule.ts uninstall",
    "format": "prettier --write src scripts tests *.ts *.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "cheerio": "1.2.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rss-parser": "3.13.0",
    "tailwindcss": "4.3.3",
    "workflow": "5.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chokidar": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "zod": "$zod",
    "undici": "^7.30.1"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  }
}
