# Optional: without this, local PostgreSQL is stored in .data/postgres via PGlite.
# Required on Vercel. Use a pooled connection string where supported.
DATABASE_URL=

# Local statistical analysis is free of API charges. External AI requires explicit opt-in.
ANALYSIS_MODE=local
# Optional Spanish translation and generative summaries. OpenAI-compatible API.
# Example for a local Ollama server: http://localhost:11434/v1
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
AI_MONTHLY_BUDGET_USD=10
# Prices must match your selected model; analysis stays off until configured.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=

# Optional, real closing stock quotes; never used to invent sample prices.
ALPHA_VANTAGE_API_KEY=

# Required when hosted: GitHub OAuth and your immutable numeric GitHub user ID.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_ALLOWED_GITHUB_ID=
CRON_SECRET=

# Local scheduling script connects only to this loopback origin.
APP_URL=http://127.0.0.1:3001
